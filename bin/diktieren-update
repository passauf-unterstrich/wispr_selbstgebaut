#!/bin/bash
# Stabiler Terminal-Starter fuer Updates.
set -e

QUELLE="${BASH_SOURCE[0]}"
while [ -L "$QUELLE" ]; do
    QUELL_ORDNER="$(cd -P "$(dirname "$QUELLE")" && pwd)"
    LINK_ZIEL="$(readlink "$QUELLE")"
    case "$LINK_ZIEL" in
        /*) QUELLE="$LINK_ZIEL" ;;
        *)  QUELLE="$QUELL_ORDNER/$LINK_ZIEL" ;;
    esac
done

APP_DIR="$(cd -P "$(dirname "$QUELLE")/.." && pwd)"
exec /bin/bash "$APP_DIR/update.sh" "$@"
